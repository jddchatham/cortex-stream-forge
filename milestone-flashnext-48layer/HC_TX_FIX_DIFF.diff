+// rounding match the stock graph bit-for-bit.
+bool compute_swiglu(ggml_backend_t backend, const float * gate, const float * up,
+                    float * act /* [F] */) {
+    ggml_init_params ip { 4 * 1024 * 1024, nullptr, true };
+    ggml_context * c = ggml_init(ip);
+    if (!c) return false;
