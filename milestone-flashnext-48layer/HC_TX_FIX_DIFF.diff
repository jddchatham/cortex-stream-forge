+    ggml_tensor * u_t = ggml_new_tensor_2d(c, GGML_TYPE_F32, F, 1);
+    ggml_tensor * act_t = ggml_swiglu_split(c, g_t, u_t);
+    ggml_cgraph * graph = ggml_new_graph(c);
